{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://labview-community-ci-cd.github.io/compare-vi-cli-action/schemas/fork-lane-index-v1.schema.json",
  "title": "Fork Lane Index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "updated_at", "active_issue", "instances"],
  "properties": {
    "schema": {
      "const": "comparevi/fork-lane-index@v1"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "active_issue": {
      "type": "integer",
      "minimum": 1
    },
    "instances": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "issue_number",
          "path",
          "title",
          "status",
          "selected_fork_id",
          "fork_repositories",
          "fork_branch",
          "upstream_branch"
        ],
        "properties": {
          "issue_number": {
            "type": "integer",
            "minimum": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": ["active", "closed", "superseded", "archived"]
          },
          "selected_fork_id": {
            "type": "string",
            "minLength": 1
          },
          "fork_repositories": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
            }
          },
          "fork_branch": {
            "type": "string",
            "minLength": 1
          },
          "upstream_branch": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
